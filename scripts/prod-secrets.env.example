# Copy this file outside the repository for production bootstrap.

# Required app secrets.
JWT_SECRET_KEY=
SESSION_SECRET_KEY=

# Optional auth integration values.
GCP_CLIENT_ID=
GCP_CLIENT_SECRET=
ADMIN_EMAIL=

# Optional observability value. Leave empty when GlitchTip is not used in prod.
GLITCHTIP_DSN=

# Optional PostgreSQL overrides.
# If these are omitted on first bootstrap, strong random passwords are generated.
# On later bootstrap runs, existing cluster values are reused automatically.
POSTGRES_USERNAME=solidapp
POSTGRES_DATABASE=solid
POSTGRES_PASSWORD=
POSTGRES_POSTGRES_PASSWORD=