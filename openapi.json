        "properties": {
          "plant_name": {
            "type": "string",
            "minLength": 1,
            "title": "Plant Name",
            "description": "The name of the plant to generate data for.",
            "examples": [
              "Fikus"
            ]
          },
          "preferred_image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
