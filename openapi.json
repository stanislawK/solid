{
  "openapi": "3.1.0",
  "info": {
    "title": "Solid API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health Check",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/plants/wiki": {
      "post": {
        "tags": [
          "plants"
        ],
        "summary": "Create Plant From Wikipedia",
        "description": "Endpoint to trigger the Wikipedia + LLM flow.",
        "operationId": "create_plant_from_wikipedia_plants_wiki_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WikipediaRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlantRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/plants/": {
      "post": {
        "tags": [
          "plants"
        ],
        "summary": "Create Plant Manually",
        "description": "Classic manual creation (SRP: Reuse the same service logic).",
        "operationId": "create_plant_manually_plants__post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlantCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlantRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/plants": {
      "get": {
        "tags": [
          "plants"
        ],
        "summary": "List Plants",
        "operationId": "list_plants_plants_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/PlantRead"
                  },
                  "type": "array",
                  "title": "Response List Plants Plants Get"
                }
              }
            }
          }
        }
      }
    },
    "/plants/{plant_id}": {
      "get": {
        "tags": [
          "plants"
        ],
        "summary": "Get Plant",
        "operationId": "get_plant_plants__plant_id__get",
        "parameters": [
          {
            "name": "plant_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Plant Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlantRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/wiki/get_wikipedia_articles": {
      "get": {
        "tags": [
          "wiki"
        ],
        "summary": "Get Wikipedia Articles",
        "operationId": "get_wikipedia_articles_wiki_get_wikipedia_articles_get",
        "parameters": [
          {
            "name": "search_term",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "The term to search for",
              "title": "Search Term"
            },
            "description": "The term to search for"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WikipediaResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Login",
        "description": "Route 1: Send the user to Google",
        "operationId": "login_auth_login_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/auth/callback": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Auth Callback",
        "description": "Route 2: Google sends the user back here with a 'code'",
        "operationId": "auth_callback_auth_callback_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Read Users Me",
        "description": "Example of an endpoint protected by JWT Token.\nOnly logged-in users sending a valid Bearer token can access this.",
        "operationId": "read_users_me_auth_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/auth/activate": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Activate User",
        "description": "Admin-only endpoint to activate a user account.",
        "operationId": "activate_user_auth_activate_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "email",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Email"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/deactivate": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Deactivate User",
        "description": "Admin-only endpoint to deactivate a user account.",
        "operationId": "deactivate_user_auth_deactivate_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "email",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Email"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "default": "ok"
          }
        },
        "type": "object",
        "title": "HealthResponse"
      },
      "PlantCreate": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "latin_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latin Name"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "watering": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Watering"
          },
          "light": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Light"
          }
        },
        "type": "object",
        "required": [
          "name",
          "watering",
          "light"
        ],
        "title": "PlantCreate"
      },
      "PlantRead": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "latin_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latin Name"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "watering": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Watering"
          },
          "light": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Light"
          },
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "added_at": {
            "type": "string",
            "format": "date-time",
            "title": "Added At"
          }
        },
        "type": "object",
        "required": [
          "name",
          "watering",
          "light",
          "id",
          "added_at"
        ],
        "title": "PlantRead"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WikipediaRequest": {
        "properties": {
          "article_title": {
            "type": "string",
            "minLength": 1,
            "title": "Article Title",
            "description": "The exact title of the Wikipedia page to fetch data from.",
            "examples": [
              "Monstera deliciosa"
            ]
          }
        },
        "type": "object",
        "required": [
          "article_title"
        ],
        "title": "WikipediaRequest"
      },
      "WikipediaResponse": {
        "properties": {
          "search_term": {
            "type": "string",
            "title": "Search Term"
          },
          "results": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Results",
            "description": "List of related Wikipedia article titles"
          }
        },
        "type": "object",
        "required": [
          "search_term",
          "results"
        ],
        "title": "WikipediaResponse"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}