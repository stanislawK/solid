              },
              {
                "type": "null"
              }
            ],
            "title": "Latin Name",
            "description": "Name of the plant in Latin"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "AiPlantProposal"
      },
      "Body_identify_and_store_plant_image_plants_identify_post": {
