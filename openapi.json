            "description": "Previously stored local image URL to keep on the created plant and skip Wikimedia image lookup.",
            "examples": [
              "/images/fikus.jpg"
            ]
          }
        },
        "type": "object",
        "required": [
          "plant_name"
        ],
        "title": "PlantNameRequest"
      },
